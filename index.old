// src/index.tsx

import React from 'react';
import ReactDOM from 'react-dom/client';

// Importações de Lógica e Contexto
import { AuthProvider } from '@/hooks/useAuth';
import { ToastProvider } from '@/hooks/useToast';
import { ChatProvider } from '@/hooks/useChat';
import { AppNotificationProvider } from '@/hooks/useAppNotifications';
import { FavoritesProvider } from '@/hooks/useFavorites';

// Importação do Componente Principal da Aplicação
import App from '@/App'; // Usando o alias para o caminho correto

// A ÚNICA importação de CSS necessária
import '@/index.css';

const rootElement = document.getElementById('root');
if (!rootElement) {
  throw new Error("Could not find root element to mount to");
}

const root = ReactDOM.createRoot(rootElement);
root.render(
  <React.StrictMode>
    <ToastProvider>
      <AuthProvider>
        <FavoritesProvider>
          <ChatProvider>
            <AppNotificationProvider>
              <App />
            </AppNotificationProvider>
          </ChatProvider>
        </FavoritesProvider>
      </AuthProvider>
    </ToastProvider>
  </React.StrictMode>
);